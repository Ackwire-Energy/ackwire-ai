<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A menu bar app: no Dock icon and no app menu, even before the Rust side sets the activation policy. -->
  <key>LSUIElement</key>
  <true/>
  <!-- The app is in Portuguese and English: the system's own menus (text fields, sharing, dialogs) follow
       the Mac's language instead of staying in English. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>pt-BR</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>pt-BR</string>
    <string>en</string>
  </array>
  <key>CFBundleAllowMixedLocalizations</key>
  <true/>
  <!-- Voice messages: what the Mac says when the site first asks for the microphone. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>agentes.chat uses the microphone to record voice messages.</string>
  <!-- Files downloaded from the site get the quarantine mark, as from a browser: the Mac checks them. -->
  <key>LSFileQuarantineEnabled</key>
  <true/>
</dict>
</plist>
