{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentes",
  "version": "0.1.0",
  "identifier": "chat.agentes.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popover",
        "url": "index.html",
        "title": "agentes",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "welcome",
        "url": "index.html",
        "title": "agentes",
        "width": 680,
        "height": 560,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "prefs",
        "url": "index.html",
        "title": "agentes",
        "width": 860,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://agentes.chat; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "agentes",
    "copyright": "agentes.chat",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/agentes-runner"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
