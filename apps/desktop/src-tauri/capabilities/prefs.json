  "permissions": [
    "core:default",
    "allow-runners-list",
    "allow-runner-send",
    "allow-runner-remove",
    "allow-open-external",
    "allow-reveal-folder",
    "allow-pick-folder",
    "allow-servers-get",
    "allow-server-choose",
    "allow-server-remove",
    "allow-tray-visible",
    "allow-notify-site-set",
    "allow-show-window",
    "allow-hide-window",
    "allow-app-info",
    "allow-notch-set",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-update-install",
    "allow-update-cancel",
    "allow-dock-set",
    "allow-local-server-status",
    "allow-local-server-start",
    "allow-local-server-stop",
    "allow-local-server-restart",
    "allow-local-server-reach",
    "allow-local-server-usage",
    "allow-local-server-backup",
    "allow-local-server-diagnostics",
    "allow-tailscale-status",
    "allow-tailscale-open"
