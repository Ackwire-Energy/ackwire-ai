{
  "name": "agentes-chat",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "ee"
  ],
  "scripts": {
    "dev": "bun run --filter '@agenteschat/server' --filter '@agenteschat/web' dev",
    "start": "bun run --filter '@agenteschat/server' start",
    "build": "bun run --filter '@agenteschat/web' build && bun run --filter '@agenteschat/server' build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "db:generate": "cd packages/db && bunx drizzle-kit generate --name",
    "docs:env": "bun run --filter '@agenteschat/config' docs",
    "smoke": "bun --env-file=.env scripts/smoke.ts",
    "eval:memory": "bun --env-file=.env packages/engine/eval/memory.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.1",
  "license": "UNLICENSED"
}
